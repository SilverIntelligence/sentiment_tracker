# Database
DATABASE_URL=postgresql://sentiment:sentiment@localhost:5432/sentiment_tracker
REDIS_URL=redis://localhost:6379/0

# Reddit API
REDDIT_CLIENT_ID=your_client_id
REDDIT_CLIENT_SECRET=your_client_secret
REDDIT_USERNAME=your_username
REDDIT_PASSWORD=your_password
REDDIT_USER_AGENT=sentiment_tracker/1.0

# Target Subreddits (comma-separated)
TARGET_SUBREDDITS=wallstreetsilver,gold,silverbugs

# Price APIs
PRICE_API_KEY=your_price_api_key
# Or use Yahoo Finance (no key needed)
USE_YAHOO_FINANCE=true

# Application
ENVIRONMENT=development
LOG_LEVEL=INFO
API_PORT=8000

# Security
SECRET_KEY=your-secret-key-change-this-in-production
ADMIN_TOKEN=your-admin-token

# Processing
BATCH_SIZE=100
INGESTION_INTERVAL_POSTS=60
INGESTION_INTERVAL_COMMENTS=30

# Caching
CACHE_TTL_SECONDS=60
SNAPSHOT_TTL_SECONDS=60

# Retention
RAW_DATA_RETENTION_DAYS=90
